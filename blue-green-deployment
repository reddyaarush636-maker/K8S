apiVersion: apps/v1
kind: Deployment
metadata:
  name: netflix-blue
  labels:
    app: netflix
    version: blue

spec:
  replicas: 4

  selector:
    matchLabels:
      app: netflix
      version: blue

  template:
    metadata:
      labels:
        app: netflix
        version: blue

    spec:
      containers:
        - name: netflix-container
          image: reddyaarush636/netflixv1:latest
          ports:
            - containerPort: 80

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: netflix-green
  labels:
    app: netflix
    version: green

spec:
  replicas: 4

  selector:
    matchLabels:
      app: netflix
      version: green

  template:
    metadata:
      labels:
        app: netflix
        version: green

    spec:
      containers:
        - name: netflix-container
          image: reddyaarush636/netflixv2:latest
          ports:
            - containerPort: 80

---
apiVersion: v1
kind: Service
metadata:
  name: netflix-service

spec:
  type: NodePort

  selector:
    app: netflix
    version: blue

  ports:
    - port: 80
      targetPort: 80
      nodePort: 31111
