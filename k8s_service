apiVersion: apps/v1
kind: Deployment
metadata:
  name: movies-deploy
  labels:
    app: movies

spec:
  replicas: 10

  selector:
    matchLabels:
      app: movies

  template:
    metadata:
      labels:
        app: movies

    spec:
      containers:
        - name: cont1
          image: reddyaarush636/movies:latest
          ports:
            - containerPort: 80

---
apiVersion: v1
kind: Service
metadata:
  name: abc

spec:
  type: ClusterIP

  selector:
    app: movies

  ports:
    - port: 80
      targetPort: 80
