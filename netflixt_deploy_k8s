apiVersion: apps/v1
kind: Deployment
metadata:
  name: netflix-deploy
  labels:
    app: netflix

spec:
  replicas: 4

  selector:
    matchLabels:
      app: netflix

  template:
    metadata:
      labels:
        app: netflix

    spec:
      containers:
        - name: cont1
          image: reddyaarush636/netflixv1:latest
          ports:
            - containerPort: 80

---
apiVersion: v1
kind: Service
metadata:
  name: service1

spec:
  type: NodePort

  selector:
    app: netflix

  ports:
    - port: 80
      targetPort: 80
      nodePort: 31111
