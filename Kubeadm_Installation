 --------------------------if not joint in worker-note to master node so reset master-node complitely------------------
 #appy master-node
 1. Reset master completely
 sudo kubeadm reset -f
sudo rm -rf /etc/kubernetes/
sudo rm -rf /var/lib/etcd
sudo rm -rf $HOME/.kube
2. Make sure system is ready
sudo swapoff -a
sudo modprobe br_netfilter
sudo sysctl -w net.ipv4.ip_forward=1
3. Re-initialize cluster
sudo kubeadm init --apiserver-advertise-address=<put master-node private-ip> \
--pod-network-cidr=192.168.0.0/16
4. Configure kubectl
mkdir -p $HOME/.kube
sudo cp -i /etc/kubernetes/admin.conf $HOME/.kube/config
sudo chown $(id -u):$(id -g) $HOME/.kube/config
5. Verify API server
kubectl get nodes
6. Install network (CNI)
kubectl apply -f https://docs.projectcalico.org/manifests/calico.yaml
