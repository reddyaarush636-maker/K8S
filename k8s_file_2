apiVersion: apps/v1
kind: Deployment
metadata:
  name: amazone
  labels:
    app: amazone

spec:
  replicas: 4

  selector:
    matchLabels:
      app: amazone

  template:
    metadata:
      labels:
        app: amazone

    spec:
      containers:
        - name: cont1
          image: reddyaarush636/amazone-app:latest
          ports:
            - containerPort: 80

---
apiVersion: v1
kind: Service
metadata:
  name: service1

spec:
  type: NodePort

  selector:
    app: amazone

  ports:
    - port: 80
      targetPort: 80
      nodePort: 31111
