apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-deployment
  labels:
    app: nginx
    version: stable

spec:
  replicas: 3

  selector:
    matchLabels:
      app: nginx
      version: stable

  template:
    metadata:
      labels:
        app: nginx
        version: stable

    spec:
      containers:
        - name: nginx
          image: reddyaarush636/mynetflixv1:latest
          ports:
            - containerPort: 80

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-deployment-canary
  labels:
    app: nginx
    version: canary

spec:
  replicas: 1

  selector:
    matchLabels:
      app: nginx
      version: canary

  template:
    metadata:
      labels:
        app: nginx
        version: canary

    spec:
      containers:
        - name: nginx
          image: reddyaarush636/netflixv2.0:latest
          ports:
            - containerPort: 80

---
apiVersion: v1
kind: Service
metadata:
  name: service2

spec:
  type: NodePort

  selector:
    app: nginx

  ports:
    - protocol: TCP
      port: 80
      targetPort: 80
      nodePort: 31112
